# Planner arms with candidate-calibrated thresholds. Needs results/plandiag_<name>.tar.gz.
# Usage:  condor_submit eval_cand.sub name=p4_grounded_ycb_s10 run=grounded task=PickSingleYCB-v1 preset=fixes
# Output: results/evalcand_<name>_<preset>.tar.gz
universe = container
container_image = file:///staging/s/smittal39/tdmpc2_v2.sif

executable = eval_cand.sh
arguments = $(name) $(run) $(task) $(preset) $(extra)
transfer_input_files = code.tar.gz, results/$(name).tar.gz, results/plandiag_$(name).tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = evalout.tar.gz
transfer_output_remaps = "evalout.tar.gz = results/evalcand_$(name)_$(preset).tar.gz"
stream_output = True
stream_error = True

log = logs/evalcand_$(name)_$(preset).log
output = logs/evalcand_$(name)_$(preset).$(Cluster).out
error = logs/evalcand_$(name)_$(preset).$(Cluster).err

requirements = (HasCHTCStaging == true)
request_gpus = 1
gpus_minimum_capability = 7.0
gpus_maximum_capability = 9.0
+WantGPULab = true
+GPUJobLength = "medium"
request_cpus = 4
request_memory = 16GB
request_disk = 30GB

queue
