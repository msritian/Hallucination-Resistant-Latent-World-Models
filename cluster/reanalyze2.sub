# Re-analyse saved preflight episodes with the gradual-drift signals (Aa, Ac). One job per line of the queue file.
# Usage:  condor_submit reanalyze2.sub queue_file=detect_dev.txt       (development models first)
#         condor_submit reanalyze2.sub queue_file=detect_confirm.txt   (only after the choice is pre-registered)
# Output: results/detect_<grounded>.tar.gz
universe = container
container_image = file:///staging/s/smittal39/tdmpc2_v2.sif

executable = reanalyze.sh
arguments = $(task) $(grounded) $(stock)
transfer_input_files = code.tar.gz, results/$(grounded).tar.gz, results/$(stock).tar.gz, results/preflight_$(grounded).tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True
transfer_output_files = reanalysis.tar.gz
transfer_output_remaps = "reanalysis.tar.gz = results/detect_$(grounded).tar.gz"

log = logs/detect_$(grounded).log
output = logs/detect_$(grounded).$(Cluster).out
error = logs/detect_$(grounded).$(Cluster).err

requirements = (HasCHTCStaging == true)
request_gpus = 1
gpus_minimum_capability = 7.0
gpus_maximum_capability = 9.0
+WantGPULab = true
+GPUJobLength = "short"
request_cpus = 4
request_memory = 16GB
request_disk = 30GB

queue task, grounded, stock from $(queue_file)
