# Usage:  condor_submit bench.sub run=grounded   (or run=stock)
universe = container
container_image = file:///staging/s/smittal39/tdmpc2_v3.sif
executable = bench.sh
arguments = --run $(run) --task PegInsertionSide-v1
transfer_input_files = code.tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True
log = logs/bench_$(run).log
output = logs/bench_$(run).$(Cluster).out
error = logs/bench_$(run).$(Cluster).err
requirements = (HasCHTCStaging == true)
request_gpus = 1
gpus_minimum_capability = 7.0
gpus_maximum_capability = 12.0
+WantGPULab = true
+GPUJobLength = "short"
request_cpus = 4
request_memory = 32GB
request_disk = 20GB
queue
