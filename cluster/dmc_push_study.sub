# DMC disturbance gate study (docs/preregistration_dmc_push.md).
# Usage: condor_submit dmc_push_study.sub queue_file=dmc_pushg_runs.txt
universe = container
container_image = file:///staging/s/smittal39/tdmpc2_v3.sif
executable = dmc_push_study.sh
arguments = $(task) $(episodes) $(cal_episodes) $(seed0) $(push)
transfer_input_files = code_dmc/code.tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True
transfer_output_files = dcm.tar.gz
transfer_output_remaps = "dcm.tar.gz = results/$(name).tar.gz"
log = logs/$(name).log
output = logs/$(name).$(Cluster).out
error = logs/$(name).$(Cluster).err
requirements = (HasCHTCStaging == true) && (TARGET.Machine =!= "gpu117.cm.cluster") && (TARGET.Machine =!= "gpu4001.chtc.wisc.edu")
request_gpus = 1
gpus_minimum_capability = 7.0
gpus_maximum_capability = 12.0
+WantGPULab = true
+GPUJobLength = "medium"
request_cpus = 4
request_memory = 12GB
request_disk = 20GB
queue name, task, episodes, cal_episodes, seed0, push from $(queue_file)
