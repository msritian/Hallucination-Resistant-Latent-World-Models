# Seed-50 confirmation: fresh simulator-labelled episodes, detection analysis AND saved per-step features, in one job.
# Usage:  condor_submit confirm.sub queue_file=realcheck_s50.txt
# Output: results/real_<grounded>.tar.gz (contains features_<model>.pt for the offline analyses)
universe = container
container_image = file:///staging/s/smittal39/tdmpc2_v2.sif

executable = preflight.sh
arguments = $(task) $(grounded) $(stock) --dump_features
transfer_input_files = code.tar.gz, results/$(grounded).tar.gz, results/$(stock).tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True
transfer_output_files = preflight.tar.gz
transfer_output_remaps = "preflight.tar.gz = results/real_$(grounded).tar.gz"

log = logs/real_$(grounded).log
output = logs/real_$(grounded).$(Cluster).out
error = logs/real_$(grounded).$(Cluster).err

requirements = (HasCHTCStaging == true)
request_gpus = 1
gpus_minimum_capability = 7.0
gpus_maximum_capability = 9.0
+WantGPULab = true
+GPUJobLength = "short"
request_cpus = 4
request_memory = 16GB
request_disk = 30GB

queue task, grounded, stock from $(queue_file)
