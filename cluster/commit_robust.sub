# Robust imagined regret study (src/robust_regret.py), backfill route (container + model via OSDF, CHTC pool).
# Usage: condor_submit commit_robust.sub queue_file=robust_smoke.txt  (then robust_runs.txt)
universe = container
container_image = osdf:///chtc/staging/s/smittal39/tdmpc2_v3.sif

executable = commit_robust.sh
arguments = $(task) $(grounded) $(fr) $(episodes) $(cal_episodes)
transfer_input_files = code_robust/code.tar.gz, results/$(fr), osdf:///chtc/staging/s/smittal39/wm-results/$(grounded).tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True

# Self-checkpointing: exit code 85 = "checkpoint saved, restart me"; ./gen is saved and restored across restarts.
checkpoint_exit_code = 85
transfer_checkpoint_files = com
transfer_output_files = commit.tar.gz
transfer_output_remaps = "commit.tar.gz = results/$(name).tar.gz"

log = logs/$(name).log
output = logs/$(name).$(Cluster).$(Process).out
error = logs/$(name).$(Cluster).$(Process).err

# gpu117.cm.cluster lacks libGL: jobs crash at import there.
requirements = (TARGET.PoolName =?= "CHTC") && (TARGET.Machine =!= "gpu117.cm.cluster") && (TARGET.Machine =!= "gpu4001.chtc.wisc.edu")
request_gpus = 1
gpus_minimum_capability = 7.0
gpus_maximum_capability = 12.0
+WantGPULab = true
+GPUJobLength = "short"
request_cpus = 4
request_memory = 8GB
request_disk = 30GB

queue name, task, grounded, fr, episodes, cal_episodes from $(queue_file)
