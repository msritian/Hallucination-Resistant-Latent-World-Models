# AdaReP-style gate added to the live IR archives (docs/preregistration_live_ir.md, amendment 1), backfill route (container + model via OSDF, CHTC pool).
# Usage: condor_submit commit_adr.sub queue_file=adr_smoke.txt  (then adr_new_runs.txt, adr_check_runs.txt, adr_stock_runs.txt)
universe = container
container_image = osdf:///chtc/staging/s/smittal39/tdmpc2_v3.sif

executable = commit_live.sh
arguments = $(task) $(grounded) $(run) $(archive) $(dir) $(episodes) $(seed_start) adr
transfer_input_files = code_adr/code.tar.gz, results/$(archive), osdf:///chtc/staging/s/smittal39/wm-results/$(grounded).tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True

# Self-checkpointing: exit code 85 = "checkpoint saved, restart me"; ./gen is saved and restored across restarts.
checkpoint_exit_code = 85
transfer_checkpoint_files = $(dir)
transfer_output_files = commit.tar.gz
transfer_output_remaps = "commit.tar.gz = results/$(name).tar.gz"

log = logs/$(name).log
output = logs/$(name).$(Cluster).$(Process).out
error = logs/$(name).$(Cluster).$(Process).err

# gpu117.cm.cluster lacks libGL: jobs crash at import there.
requirements = (TARGET.PoolName =?= "CHTC") && (TARGET.Machine =!= "gpu117.cm.cluster") && (TARGET.Machine =!= "gpu4001.chtc.wisc.edu")
request_gpus = 1
gpus_minimum_capability = 7.0
gpus_maximum_capability = 12.0
+WantGPULab = true
+GPUJobLength = "short"
request_cpus = 4
request_memory = 8GB
request_disk = 30GB

queue name, task, grounded, run, archive, dir, episodes, seed_start from $(queue_file)
