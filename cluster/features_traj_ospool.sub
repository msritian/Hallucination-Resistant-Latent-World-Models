# features_traj.sub that can also run on the OSPool (container via OSDF; no CHTC staging needed).
# Usage:  condor_submit features_traj_ospool.sub queue_file=ftraj_rest.txt prefix=
universe = container
container_image = osdf:///chtc/staging/s/smittal39/tdmpc2_v3.sif

executable = features_h.sh
arguments = $(task) $(grounded) $(stock) --horizon $(h)
transfer_input_files = code_traj/code.tar.gz, results/$(grounded).tar.gz, results/$(stock).tar.gz, results/real_$(grounded).tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True
transfer_output_files = reanalysis.tar.gz
transfer_output_remaps = "reanalysis.tar.gz = results/$(prefix)ftraj_h$(h)_$(grounded).tar.gz"

log = logs/$(prefix)ftraj_h$(h)_$(grounded).log
output = logs/$(prefix)ftraj_h$(h)_$(grounded).$(Cluster).out
error = logs/$(prefix)ftraj_h$(h)_$(grounded).$(Cluster).err

requirements = True
+WantFlocking = true
+WantGlidein = true
request_gpus = 1
gpus_minimum_capability = 7.0
gpus_maximum_capability = 12.0
+WantGPULab = true
+GPUJobLength = "short"
request_cpus = 4
request_memory = 8GB
request_disk = 30GB

queue h, task, grounded, stock from $(queue_file)
