# Offline pessimistic planning (docs/preregistration_offline_pessimism.md)
# Usage: condor_submit rerank.sub queue_file=rerank_smoke.txt (then rerank_runs.txt)
# Output: results/<name>.tar.gz
universe = container
container_image = file:///staging/s/smittal39/tdmpc2_v2.sif

executable = offline_plan.sh
arguments = $(task) $(robot) $(episodes)
transfer_input_files = code.tar.gz, results/$(robot).tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True

# Self-checkpointing: exit code 85 = "checkpoint saved, restart me"; ./rr is saved and restored across restarts.
checkpoint_exit_code = 85
transfer_checkpoint_files = op
transfer_output_files = op.tar.gz
transfer_output_remaps = "op.tar.gz = results/$(name).tar.gz"

log = logs/$(name).log
output = logs/$(name).$(Cluster).$(Process).out
error = logs/$(name).$(Cluster).$(Process).err

requirements = (HasCHTCStaging == true)
request_gpus = 1
gpus_minimum_capability = 7.0
gpus_maximum_capability = 9.0
+WantGPULab = true
+GPUJobLength = "short"
request_cpus = 4
request_memory = 16GB
request_disk = 30GB

queue name, task, robot, episodes from $(queue_file)
