# Evaluate planner arms (standard / audited trust / ELVIS-style, several horizons) on a trained run.
# Usage:  condor_submit eval.sub name=p1_grounded_push_s10 run=grounded task=PushCube-v1 preset=pilot
# Output: results/eval_<name>_<preset>.tar.gz  (episodes.csv, summary.json, taus.json)
universe = container
container_image = file:///staging/s/smittal39/tdmpc2_v2.sif

executable = eval.sh
arguments = $(name) $(run) $(task) $(preset) $(extra)
transfer_input_files = code.tar.gz, results/$(name).tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
transfer_output_files = evalout.tar.gz
transfer_output_remaps = "evalout.tar.gz = results/eval_$(name)_$(preset).tar.gz"
stream_output = True
stream_error = True

log = logs/eval_$(name)_$(preset).log
output = logs/eval_$(name)_$(preset).$(Cluster).out
error = logs/eval_$(name)_$(preset).$(Cluster).err

requirements = (HasCHTCStaging == true)
request_gpus = 1
gpus_minimum_capability = 7.0
+WantGPULab = true
+GPUJobLength = "medium"
request_cpus = 4
request_memory = 32GB
request_disk = 30GB

queue
