# Re-analyse an existing preflight on its saved episodes (exploratory signals and analyses; the gate is unchanged).
# Usage:  condor_submit reanalyze.sub task=PickSingleYCB-v1 grounded=p4_grounded_ycb_s10 stock=p4_stock_ycb_s10
# Needs:  results/preflight_<grounded>.tar.gz.  Output: results/reanalysis_<grounded>.tar.gz
universe = container
container_image = file:///staging/s/smittal39/tdmpc2_v3.sif

executable = reanalyze.sh
arguments = $(task) $(grounded) $(stock)
transfer_input_files = code.tar.gz, results/$(grounded).tar.gz, results/$(stock).tar.gz, results/preflight_$(grounded).tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True
transfer_output_files = reanalysis.tar.gz
transfer_output_remaps = "reanalysis.tar.gz = results/reanalysis_$(grounded).tar.gz"

log = logs/reanalysis_$(grounded).log
output = logs/reanalysis_$(grounded).$(Cluster).out
error = logs/reanalysis_$(grounded).$(Cluster).err

requirements = (HasCHTCStaging == true)
request_gpus = 1
gpus_minimum_capability = 7.0
gpus_maximum_capability = 12.0
+WantGPULab = true
+GPUJobLength = "short"
request_cpus = 4
request_memory = 16GB
request_disk = 30GB

queue
