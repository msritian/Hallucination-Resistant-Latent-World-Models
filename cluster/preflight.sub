# Phase 2 go/no-go preflight on a grounded + stock pair of trained runs (results/<name>.tar.gz).
# Usage:  condor_submit preflight.sub task=PushCube-v1 grounded=p1_grounded_push_s10 stock=p1_stock_push_s10
# Output: results/preflight_<grounded>.tar.gz  (report.md, report.json, collected episodes)
universe = container
container_image = file:///staging/s/smittal39/tdmpc2_v2.sif

executable = preflight.sh
arguments = $(task) $(grounded) $(stock)
transfer_input_files = code.tar.gz, results/$(grounded).tar.gz, results/$(stock).tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True
transfer_output_files = preflight.tar.gz
transfer_output_remaps = "preflight.tar.gz = results/preflight_$(grounded).tar.gz"

log = logs/preflight_$(grounded).log
output = logs/preflight_$(grounded).$(Cluster).out
error = logs/preflight_$(grounded).$(Cluster).err

requirements = (HasCHTCStaging == true)
request_gpus = 1
gpus_minimum_capability = 7.0
+WantGPULab = true
+GPUJobLength = "short"
request_cpus = 4
request_memory = 32GB
request_disk = 30GB

queue
