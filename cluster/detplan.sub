# Detector-in-the-planner experiment, one job per robot (docs/preregistration_detector_planning.md).
# Usage:  condor_submit detplan.sub queue_file=detplan_smoke.txt   (first: 1 robot per task, 2 episodes per arm)
#         condor_submit detplan.sub queue_file=detplan_runs.txt    (then: 11 robots, 100 episodes per arm)
# Output: results/<name>.tar.gz
universe = container
container_image = file:///staging/s/smittal39/tdmpc2_v2.sif

executable = detplan.sh
arguments = $(task) $(grounded) $(episodes)
transfer_input_files = code.tar.gz, results/$(grounded).tar.gz, results/real_$(grounded).tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True

# Self-checkpointing: exit code 85 = "checkpoint saved, restart me"; ./plan is saved and restored across restarts.
checkpoint_exit_code = 85
transfer_checkpoint_files = plan
transfer_output_files = detplan.tar.gz
transfer_output_remaps = "detplan.tar.gz = results/$(name).tar.gz"

log = logs/$(name).log
output = logs/$(name).$(Cluster).$(Process).out
error = logs/$(name).$(Cluster).$(Process).err

requirements = (HasCHTCStaging == true)
request_gpus = 1
gpus_minimum_capability = 7.0
gpus_maximum_capability = 9.0
+WantGPULab = true
+GPUJobLength = "short"
request_cpus = 4
request_memory = 8GB
request_disk = 30GB

queue name, task, grounded, episodes from $(queue_file)
