# Value-error diagnostic (analysis only) on a grounded + stock pair that already has a preflight result.
# Usage:  condor_submit diagnose.sub task=PushCube-v1 grounded=p1_grounded_push_s10 stock=p1_stock_push_s10
# Output: results/diagnostic_<grounded>.tar.gz  (diagnostic.md, diagnostic.json)
universe = container
container_image = file:///staging/s/smittal39/tdmpc2_v3.sif

executable = diagnose.sh
arguments = $(task) $(grounded) $(stock) preflight_$(grounded)
transfer_input_files = code.tar.gz, results/$(grounded).tar.gz, results/$(stock).tar.gz, results/preflight_$(grounded).tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True
transfer_output_files = diagnostic.tar.gz
transfer_output_remaps = "diagnostic.tar.gz = results/diagnostic_$(grounded).tar.gz"

log = logs/diagnostic_$(grounded).log
output = logs/diagnostic_$(grounded).$(Cluster).out
error = logs/diagnostic_$(grounded).$(Cluster).err

requirements = (HasCHTCStaging == true)
request_gpus = 1
gpus_minimum_capability = 7.0
gpus_maximum_capability = 12.0
+WantGPULab = true
+GPUJobLength = "short"
request_cpus = 4
request_memory = 32GB
request_disk = 30GB

queue
