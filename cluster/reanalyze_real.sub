# Re-analyse the simulator-labelled episodes (results/real_<grounded>.tar.gz) with the current code (no new collection).
# Usage:  condor_submit reanalyze_real.sub queue_file=detect_dev.txt      Output: results/real2_<grounded>.tar.gz
universe = container
container_image = file:///staging/s/smittal39/tdmpc2_v3.sif

executable = reanalyze_real.sh
arguments = $(task) $(grounded) $(stock)
transfer_input_files = code.tar.gz, results/$(grounded).tar.gz, results/$(stock).tar.gz, results/real_$(grounded).tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True
transfer_output_files = reanalysis.tar.gz
transfer_output_remaps = "reanalysis.tar.gz = results/real2_$(grounded).tar.gz"

log = logs/real2_$(grounded).log
output = logs/real2_$(grounded).$(Cluster).out
error = logs/real2_$(grounded).$(Cluster).err

requirements = (HasCHTCStaging == true)
request_gpus = 1
gpus_minimum_capability = 7.0
gpus_maximum_capability = 12.0
+WantGPULab = true
+GPUJobLength = "short"
request_cpus = 4
request_memory = 16GB
request_disk = 30GB

queue task, grounded, stock from $(queue_file)
