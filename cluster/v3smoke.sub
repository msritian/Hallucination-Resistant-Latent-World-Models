# Re-analyse simulator-labelled episodes AND save raw per-step signals and labels for offline analyses.
# Usage:  condor_submit features.sub queue_file=features_runs.txt      Output: results/feat_<grounded>.tar.gz
universe = container
container_image = file:///staging/s/smittal39/tdmpc2_v3.sif

executable = features_h.sh
arguments = $(task) $(grounded) $(stock) --horizon $(h)
transfer_input_files = code.tar.gz, results/$(grounded).tar.gz, results/$(stock).tar.gz, results/real_$(grounded).tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True
transfer_output_files = reanalysis.tar.gz
transfer_output_remaps = "reanalysis.tar.gz = results/v3smoke_h$(h)_$(grounded).tar.gz"

log = logs/v3smoke_h$(h)_$(grounded).log
output = logs/v3smoke_h$(h)_$(grounded).$(Cluster).out
error = logs/v3smoke_h$(h)_$(grounded).$(Cluster).err

requirements = (HasCHTCStaging == true)
request_gpus = 1
gpus_minimum_capability = 12.0
gpus_maximum_capability = 12.0
+WantGPULab = true
+GPUJobLength = "short"
request_cpus = 4
request_memory = 16GB
request_disk = 30GB

queue h, task, grounded, stock from $(queue_file)
