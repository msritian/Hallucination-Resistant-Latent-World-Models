# GPU smoke test: CUDA + TD-MPC2 imports + ManiSkill3 tasks.
# Usage (on the access point):  condor_submit smoke.sub
universe = container
container_image = file:///staging/s/smittal39/tdmpc2.sif

executable = smoke.sh
transfer_input_files = smoke_env.py, code.tar.gz
transfer_output_files = pip-freeze.txt
should_transfer_files = YES
when_to_transfer_output = ON_EXIT

log = smoke.log
output = smoke.out
error = smoke.err

requirements = (HasCHTCStaging == true)
request_gpus = 1
+WantGPULab = true
+GPUJobLength = "short"
request_cpus = 4
request_memory = 16GB
request_disk = 20GB

queue
