# Wall-clock study, one job per robot (docs/preregistration_wallclock.md).
# Usage:  condor_submit commit_timing.sub queue_file=timing_smoke.txt   (first: 1 robot, 2 episodes per arm)
#         condor_submit commit_timing.sub queue_file=timing_runs.txt    (then: 12 robots, 100 episodes per arm)
# Output: results/<name>.tar.gz
universe = container
container_image = file:///staging/s/smittal39/tdmpc2_v3.sif

executable = commit_timing.sh
arguments = $(task) $(grounded) $(fr) $(episodes) $(seed_start)
transfer_input_files = code_timing/code.tar.gz, results/$(fr)
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True

# Self-checkpointing: exit code 85 = "checkpoint saved, restart me"; ./tim is saved and restored across restarts.
checkpoint_exit_code = 85
transfer_checkpoint_files = tim
transfer_output_files = commit.tar.gz
transfer_output_remaps = "commit.tar.gz = results/$(name).tar.gz"

log = logs/$(name).log
output = logs/$(name).$(Cluster).$(Process).out
error = logs/$(name).$(Cluster).$(Process).err

# gpu117.cm.cluster lacks libGL: jobs crash at import there.
requirements = (HasCHTCStaging == true) && (TARGET.Machine =!= "gpu117.cm.cluster") && (TARGET.Machine =!= "gpu4001.chtc.wisc.edu")
request_gpus = 1
gpus_minimum_capability = 7.0
gpus_maximum_capability = 12.0
+WantGPULab = true
+GPUJobLength = "short"
request_cpus = 4
request_memory = 8GB
request_disk = 30GB

queue name, task, grounded, fr, episodes, seed_start from $(queue_file)
