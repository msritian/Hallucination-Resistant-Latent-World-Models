# Interactive build job for the Apptainer image (CHTC build nodes).
# Usage (on the access point):  condor_submit -i build.sub
universe = vanilla
log = build.log

+IsBuildJob = true
requirements = (OpSysMajorVer =?= 9) && (HasCHTCStaging == true)

transfer_input_files = tdmpc2.def

request_cpus = 4
request_memory = 16GB
request_disk = 40GB

queue
