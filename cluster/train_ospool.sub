# Training jobs, one per line of the queue file (name run task seed steps [extra args]).
# Same as train.sub but can also use CHTC backfill GPUs (container via OSDF; the staging mirror is skipped there).
# CHTC pool only: without HasCHTCStaging nothing else keeps jobs in CHTC, and OSPool glideins count 10-17 GB for a job
# that uses ~2.7 GB here, so jobs there were held for memory.
# Usage:  condor_submit train_ospool.sub queue_file=runs_phase1.txt
# Outputs: ~/wm-cluster/results/<name>.tar.gz (checkpoint, CSV logs, videos, final model)
# Before the first submit:  mkdir -p logs results
universe = container
container_image = osdf:///chtc/staging/s/smittal39/tdmpc2_v3.sif

executable = train.sh
arguments = --run $(run) --task $(task) --seed $(seed) --steps $(steps) $(extra)
transfer_input_files = code.tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True

# Self-checkpointing: exit code 85 = "checkpoint saved, restart me"; ./run is saved and restored across restarts.
checkpoint_exit_code = 85
transfer_checkpoint_files = run
transfer_output_files = run.tar.gz
transfer_output_remaps = "run.tar.gz = results/$(name).tar.gz"

log = logs/$(name).log
output = logs/$(name).$(Cluster).$(Process).out
error = logs/$(name).$(Cluster).$(Process).err

# gpu117.cm.cluster lacks libGL: jobs crash at import there.
requirements = (TARGET.PoolName =?= "CHTC") && (TARGET.Machine =!= "gpu117.cm.cluster")

request_gpus = 1
gpus_minimum_capability = 7.0
gpus_maximum_capability = 12.0
+WantGPULab = true
+GPUJobLength = "short"
request_cpus = 4
request_memory = 6GB
request_disk = 20GB

queue name, run, task, seed, steps, extra from $(queue_file)
