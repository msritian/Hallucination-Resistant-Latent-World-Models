# DMC headroom pilot (docs/protocol_dmc_headroom_pilot.md): fixed k only. condor_submit dmc_headroom.sub queue_file=dmc_headroom_runs.txt
universe = container
container_image = file:///staging/s/smittal39/tdmpc2_v3.sif
executable = dmc_commit.sh
arguments = $(task) $(episodes) $(cal_episodes) $(fixed) $(seed0)
transfer_input_files = code_dmc/code.tar.gz
should_transfer_files = YES
when_to_transfer_output = ON_EXIT
stream_output = True
stream_error = True
transfer_output_files = dcm.tar.gz
transfer_output_remaps = "dcm.tar.gz = results/$(name).tar.gz"
log = logs/$(name).log
output = logs/$(name).$(Cluster).out
error = logs/$(name).$(Cluster).err
requirements = (HasCHTCStaging == true) && (TARGET.Machine =!= "gpu117.cm.cluster")
request_gpus = 1
gpus_minimum_capability = 7.0
gpus_maximum_capability = 12.0
+WantGPULab = true
+GPUJobLength = "short"
request_cpus = 4
request_memory = 12GB
request_disk = 20GB
queue name, task, episodes, cal_episodes, fixed, seed0 from $(queue_file)
